{
  "layer": "top",
  "position": "top",
  "height": 46,
  "margin-top": 10,
  "margin-left": 28,
  "margin-right": 28,
  "spacing": 0,
  "reload_style_on_change": true,
  "modules-left": ["custom/edition", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["group/telemetry", "custom/emblem", "group/time"],
  "modules-right": ["mpris", "group/controls"],
  "custom/edition": {
    "format": "01   S P E C T R A    /    Angular · Distinct · Refined",
    "tooltip": false
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "persistent-workspaces": {"*": 5},
    "on-scroll-up": "hyprctl dispatch workspace +1",
    "on-scroll-down": "hyprctl dispatch workspace -1"
  },
  "hyprland/window": {"format": "{title}", "max-length": 34, "separate-outputs": true},
  "group/telemetry": {"orientation": "horizontal", "modules": ["temperature", "cpu", "memory"]},
  "temperature": {"format": " {temperatureC}°C", "critical-threshold": 85},
  "cpu": {"format": " {usage}%", "interval": 5},
  "memory": {"format": " {percentage}%", "interval": 5},
  "custom/emblem": {"format": "󰣇", "tooltip": false, "on-click": "omarchy-menu"},
  "group/time": {"orientation": "horizontal", "modules": ["clock", "custom/updates"]},
  "clock": {"format": " {:%a %d  |  %H:%M}", "tooltip-format": "<big>{:%B %Y}</big>\n<tt>{calendar}</tt>"},
  "custom/updates": {"exec": "~/.config/waybar/scripts/updates.sh", "return-type": "json", "interval": 3600, "format": "{}", "on-click": "omarchy-launch-floating-terminal-with-presentation omarchy-update"},
  "mpris": {"format": "󰐊 {title} - {artist}", "format-paused": "󰏤 {title} - {artist}", "max-length": 32},
  "group/controls": {"orientation": "horizontal", "modules": ["pulseaudio", "network", "bluetooth", "battery", "custom/power"]},
  "pulseaudio": {"format": " {volume}%", "format-muted": "", "on-click": "omarchy-shell shell toggle omarchy.audio"},
  "network": {"format-wifi": "", "format-ethernet": "󰈀", "format-disconnected": "󰖪", "tooltip-format": "{ifname}: {ipaddr}", "on-click": "omarchy-shell shell toggle omarchy.network"},
  "bluetooth": {"format": "", "format-disabled": "", "on-click": "omarchy-shell shell toggle omarchy.bluetooth"},
  "battery": {"format": "󰁹 {capacity}%", "format-charging": "󰂄 {capacity}%", "states": {"warning": 25, "critical": 10}},
  "custom/power": {"format": "󰐥", "tooltip": false, "on-click": "omarchy-shell shell toggle omarchy.power"}
}
