{
  "position": "top",
  "transparent": false,
  "centerAnchor": "spectra.emblem",
  "layout": {
    "left": [
      {
        "id": "omarchy.menu"
      },
      {
        "id": "omarchy.workspaces"
      },
      {
        "id": "omarchy.active-window",
        "maxWidth": 250
      }
    ],
    "center": [
      {
        "id": "spectra.stats",
        "type": "command",
        "exec": "~/.config/omarchy/plugins/itsw1n.spectra-bar/scripts/stats.sh",
        "interval": 5
      },
      {
        "id": "omarchy.indicators"
      },
      {
        "id": "spectra.emblem",
        "type": "command",
        "exec": "printf '  \udb82\udcc7  '",
        "interval": 3600,
        "fontSize": 21
      },
      {
        "id": "omarchy.clock",
        "format": "ddd d  |  HH:mm"
      },
      {
        "id": "omarchy.system-update"
      }
    ],
    "right": [
      {
        "id": "omarchy.media"
      },
      {
        "id": "omarchy.audio"
      },
      {
        "id": "omarchy.network"
      },
      {
        "id": "omarchy.bluetooth"
      },
      {
        "id": "omarchy.monitor"
      },
      {
        "id": "omarchy.power",
        "showPercentage": true
      }
    ]
  }
}
